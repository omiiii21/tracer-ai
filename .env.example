# tracer-ai env-var contract (committed; copy to .env and edit)
# Per D-2.21: all REQUIRED vars are validated at import time; missing => ValidationError.
# Per D-2.23: NEVER commit a real value here. Placeholders only.

# === Required (fail-fast on missing) ===
DATABASE_URL=postgresql+asyncpg://tracer:tracer@db:5432/tracer_ai
ANTHROPIC_API_KEY=sk-ant-REPLACE
VOYAGE_API_KEY=REPLACE

# === Optional with defaults ===
LLM_BOT_MODEL=claude-sonnet-4-5-20250929
LLM_JUDGE_MODEL=claude-haiku-4-5-20251001
EMBEDDING_MODEL=voyage-code-3
LOG_LEVEL=INFO
ENABLE_RERANKER=false

# === Phase 5: Quality Layer + Feedback ===
BAD_ANSWER_FAITHFULNESS_THRESHOLD=0.6
JUDGE_CONCURRENCY=4
JUDGE_TIMEOUT_SECONDS=10.0
# CALIBRATION_DATE=2026-05-15T00:00:00Z   # uncomment after first calibration; tz suffix recommended
