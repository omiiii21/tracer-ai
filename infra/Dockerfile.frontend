# syntax=docker/dockerfile:1.7
# Multi-stage Dockerfile for tracer-ai frontend
# Per D-2.13: stages are base / deps / dev / build / prod (prod NOT BUILT in Phase 2)
# Per RESEARCH.md Topic 10: anonymous /app/node_modules volume + Vite polling watcher

ARG NODE_VERSION=20.18.0

# ============================================================================
# STAGE 1: base -- node:20-alpine
# ============================================================================
FROM node:20.18.0-alpine AS base
WORKDIR /app
ENV NODE_ENV=development

# ============================================================================
# STAGE 2: deps -- npm ci (cacheable)
# ============================================================================
FROM base AS deps
# Make /app owned by node user up-front so subsequent COPY --chown and the
# running Vite dev server can write sibling files (e.g. vite.config.ts.timestamp-*.mjs
# that Vite emits when bundling the config). Plan 02-05 Rule 1 fix: without
# chown, the dev stage fails with EACCES when the `node` user tries to write
# the timestamp temp file into the root-owned /app/.
RUN chown -R node:node /app
USER node
COPY --chown=node:node frontend/package.json frontend/package-lock.json* ./
# Wave 5 (Plan 02-05) ships frontend/package-lock.json -- prefer `npm ci` for
# deterministic, reproducible installs. Fallback to `npm install` keeps the
# stage usable if a future plan ever drops the lockfile.
RUN if [ -f /app/package-lock.json ]; then npm ci; else npm install; fi

# ============================================================================
# STAGE 3: dev -- compose targets this; source bind-mounted at runtime
# ============================================================================
FROM deps AS dev
COPY --chown=node:node frontend ./
EXPOSE 5173
ENV CHOKIDAR_USEPOLLING=true
# `node` user already active from deps stage (uid 1000)
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]

# ============================================================================
# STAGE 4: build -- produces /app/dist for prod nginx-serve
# ============================================================================
FROM deps AS build
COPY --chown=node:node frontend ./
RUN npm run build

# ============================================================================
# STAGE 5: prod -- NOT BUILT in Phase 2
# ============================================================================
FROM nginx:1.27-alpine AS prod
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
